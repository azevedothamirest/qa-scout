{
  "name": "qa-scout",
  "version": "1.0.2",
  "private": true,
  "description": "Companheiro de teste exploratório baseado em sessões (SBTM): extensão do Chrome, versão web, navegador de teste e servidor MCP para o Claude.",
  "homepage": "https://azevedothamirest.github.io/qa-scout/",
  "repository": {
    "type": "git",
    "url": "https://github.com/azevedothamirest/qa-scout.git"
  },
  "bugs": {
    "url": "https://github.com/azevedothamirest/qa-scout/issues"
  },
  "keywords": [
    "qa",
    "teste-exploratorio",
    "exploratory-testing",
    "sbtm",
    "chrome-extension",
    "playwright",
    "mcp",
    "claude"
  ],
  "license": "MIT",
  "author": "Thamires Azevedo",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "qa-scout": "bin/qa-scout.js"
  },
  "files": [
    "bin/",
    "app/"
  ],
  "scripts": {
    "start": "node scripts/servidor.js",
    "navegador": "node bin/qa-scout.js",
    "test": "playwright test",
    "test:regressao": "playwright test --grep @regressao",
    "test:report": "playwright show-report",
    "pacote": "node scripts/empacotar.js",
    "mcp": "node bin/qa-scout.js mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "1.56.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0"
  }
}
