{
  "manifest_version": 3,
  "name": "QA Scout",
  "version": "0.5.0",
  "description": "Teste exploratório com missão: registra cliques, prints, erros de console e rede das abas que você acompanhar e gera o relatório.",
  "icons": { "16": "icones/icone-16.png", "32": "icones/icone-32.png", "48": "icones/icone-48.png", "128": "icones/icone-128.png" },
  "action": { "default_title": "Abrir o QA Scout", "default_icon": { "16": "icones/icone-16.png", "32": "icones/icone-32.png" } },
  "side_panel": { "default_path": "index.html" },
  "background": { "service_worker": "extensao/background.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*", "file://*/*"], "js": ["extensao/pagina.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false }],
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs", "scripting", "webRequest"],
  "host_permissions": ["<all_urls>"]
}
